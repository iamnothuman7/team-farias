# Copie para .env. Nunca versione credenciais reais.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-local-only-generate-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL — banco e usuário dedicados ao projeto
POSTGRES_DB=teamfarias
POSTGRES_USER=teamfarias
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Em produção: DEBUG=0, chave forte, hosts reais e HTTPS.
# POSTGRES_SSLMODE=verify-full quando o provedor disponibilizar certificado CA.
# Cookies seguros e redirecionamento HTTPS ficam habilitados com DEBUG=0.
# Contatos, textos, aparência e plano: /painel/configuracoes/

# Web Push: chave privada em arquivo fora do Git, legível pelo usuário do serviço.
WEBPUSH_PRIVATE_KEY=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_SUBJECT=https://teamfarias.nabio.pro
