# Copie para .env e ajuste os valores.
# Gere uma nova chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0

# Banco (SQLite por padrão; em produção use PostgreSQL)
DJANGO_DB_NAME=db.sqlite3

# Dados de contato exibidos no site
SITE_PHONE=(85) 90000-0000
SITE_WHATSAPP=5585900000000
SITE_EMAIL=contato@teamfarias.com.br
SITE_INSTAGRAM=teamfarias
SITE_CITY=Fortaleza
SITE_STATE=CE
SITE_ADDRESS=Quadra de areia — Beira-Mar, Fortaleza/CE
SITE_PIX_KEY=contato@teamfarias.com.br
